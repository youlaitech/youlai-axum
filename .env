# ============================================================
# youlai-rust 环境配置
# ============================================================

APP__NAME=youlai-rust
APP__ENV=dev

SERVER__HOST=0.0.0.0
SERVER__PORT=8000

# PostgreSQL
DATABASE__URL=postgres://youlai:Youlai%402026@www.youlai.tech:15432/youlai_admin
DATABASE__MAX_CONNECTIONS=20
DATABASE__MIN_CONNECTIONS=5

# Redis
REDIS__URL=redis://:123456@www.youlai.tech:6379/0

# JWT
SECURITY__SESSION__TYPE=jwt
SECURITY__SESSION__ACCESS_TOKEN_TIME_TO_LIVE=7200
SECURITY__SESSION__REFRESH_TOKEN_TIME_TO_LIVE=604800
SECURITY__SESSION__JWT__SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789

SECURITY__IGNORE_URLS=/api/v1/auth/login/**,/api/v1/auth/captcha,/api/v1/auth/sms/code,/api/v1/auth/refresh-token,/api/v1/wxma/auth/**,/doc.html,/swagger-ui,/swagger-ui/*,/openapi.json

# MinIO（可选）
# MINIO__ENDPOINT=http://localhost:9000
# MINIO__ACCESS_KEY=minioadmin
# MINIO__SECRET_KEY=minioadmin
# MINIO__BUCKET=public

RATE_LIMIT__QPS=100
